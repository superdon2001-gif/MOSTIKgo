# === Локальный сервер (netlify dev / свой Postgres) ===
# Строка подключения к Postgres. Обязательна для локального запуска,
# если не используете netlify link к сайту с Netlify Database.
#
# Примеры:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/mostik
# DATABASE_URL=postgresql://user:pass@hostname/neondb?sslmode=require
DATABASE_URL=

# Алиасы (достаточно одного из них)
# NETLIFY_DATABASE_URL=
# NEON_DATABASE_URL=

# Почта восстановления пароля (необязательно)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
